% Definindo contadores que são reiniciados a cada nova seção
\newcounter{counterIn}
\newcounter{counterOut}


% Comando para entradas do ChatGPT
\newcommand{\chatgptin}[2][]{ % #1 é opcional para o label
  \refstepcounter{counterIn}\par\medskip
  \textbf{Prompt \thecounterIn: #2Architect }\ifx&#1&\else\label{#1}\fi
}


\newcommand{\chatgptquest}[2][]{ % #1 é opcional para o label
  \refstepcounter{counterIn}\par\medskip
  \textbf{Prompt \thecounterIn: #2Teacher }\ifx&#1&\else\label{#1}\fi
}

% Comando para saídas do ChatGPT
\newcommand{\chatgptout}[2][]{ % #1 é opcional para o label
  \refstepcounter{counterOut}\par\medskip
  \textbf{Output \thecounterOut: #2ChatGPT }\ifx&#1&\else\label{#1}\fi
}

